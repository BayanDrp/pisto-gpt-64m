{
  "model_name": "aubmindlab/aragpt2-large",
  "trust_remote_code": true,
  "max_len": 512,
  "use_arabert": true,
  "training": {
    "max_hours": 9,
    "grad_accum": 8,
    "max_steps": 3000,
    "warmup_steps": 100,
    "log_every": 10,
    "eval_every": 150,
    "lr": 2e-5,
    "lr_min": 2e-6,
    "batch_size": 8,
    "overfit_patience": 5
  },
  "dataset": {
    "local_path": "data/good_instruct_answers.jsonl",
    "local_repeat": 3,
    "hf_datasets": [
      "arbml/alpaca_arabic",
      "saillab/alpaca-arabic-cleaned",
      "AhmedBou/Arabic_instruction_dataset_for_llm_ft",
      "RASHID778/arabic-instruct-curated",
      "FreedomIntelligence/alpaca-gpt4-arabic"
    ],
    "hf_split": "train",
    "hf_max": 4000,
    "train_split": 0.95
  },
  "save_dir": "weights",
  "output_name": "aragpt2_instruct"
}
